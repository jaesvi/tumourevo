nextflow_process {

    name "Test Process CNAQC2CONIPHER"
    script "../main.nf"
    process "CNAQC2CONIPHER"

    tag "modules"
    tag "modules_local"
    tag "cnaqc2conipher"

    test("cnaqc2conipher - rds") {
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = [
                    [ id : "test", patient : "HCC1395", dataset : "WXS" ],
                    file(params.modules_testdata_base_path + "delete_me/viber/HCC1395_WXS_HCC1395_multi_cnaqc_ALL.rds", checkIfExists: true),
                    [ 'HCC1395_HCC1395T' ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(path(process.out.versions[0]).yaml).match() },
                { assert file(process.out.tsv[0][1]).exists() }
            )
        }
    }

    test("cnaqc2conipher - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id : "test", patient : "HCC1395", dataset : "WXS" ],
                    file(params.modules_testdata_base_path + "delete_me/viber/HCC1395_WXS_HCC1395_multi_cnaqc_ALL.rds", checkIfExists: true),
                    [ 'HCC1395_HCC1395T' ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
