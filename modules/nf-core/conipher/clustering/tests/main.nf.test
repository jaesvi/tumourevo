nextflow_process {

    name "Test Process CONIPHER_CLUSTERING"
    script "../main.nf"
    process "CONIPHER_CLUSTERING"

    tag "modules"
    tag "modules_nfcore"
    tag "conipher"
    tag "conipher_clustering"

    test("conipher clustering") {
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = [
                    [ id : "test", patient : "CRUKTOY001", dataset : "toy" ],
                    file("${projectDir}/modules/nf-core/conipher/clustering/tests/data/input_table.tsv", checkIfExists: true),
                    [ 'CRUKTOY001_S1', 'CRUKTOY001_S2' ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(path(process.out.versions[0]).yaml).match() },
                { assert file(process.out.cluster_tsv[0][1]).exists() }
            )
        }
    }

    test("conipher clustering - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id : "test", patient : "CRUKTOY001", dataset : "toy" ],
                    file("${projectDir}/modules/nf-core/conipher/clustering/tests/data/input_table.tsv", checkIfExists: true),
                    [ 'CRUKTOY001_S1', 'CRUKTOY001_S2' ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
