nextflow_process {

    name "Test Process CONIPHER_TREEBUILDING"
    script "../main.nf"
    process "CONIPHER_TREEBUILDING"

    tag "modules"
    tag "modules_nfcore"
    tag "conipher"
    tag "conipher_treebuilding"

    test("conipher treebuilding") {
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = [
                    [ id : "test", patient : "CRUKTOY001", dataset : "toy" ],
                    file("${projectDir}/modules/nf-core/conipher/treebuilding/tests/data/clustered_table.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(path(process.out.versions[0]).yaml).match() },
                { assert file(process.out.tree_rds[0][1]).exists() }
            )
        }
    }

    test("conipher treebuilding - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id : "test", patient : "CRUKTOY001", dataset : "toy" ],
                    file("${projectDir}/modules/nf-core/conipher/treebuilding/tests/data/clustered_table.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
