// Cap process memory for a ~125 GB local machine.
// Default labels: process_medium = 42 GB, process_high = 84 GB (times task.attempt).
process {
    withLabel: process_medium {
        memory = { 16.GB * task.attempt }
    }
    withLabel: process_high {
        memory = { 32.GB * task.attempt }
    }
}
